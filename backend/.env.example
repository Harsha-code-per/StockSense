# Copy to .env (never commit .env)

# Local Docker Postgres. Neon: pooled string, scheme postgresql+psycopg://, keep ?sslmode=require
DATABASE_URL=postgresql+psycopg://stocksense:stocksense@localhost:5432/stocksense

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false

FRONTEND_ORIGIN=http://localhost:3000

# Leave SMTP_HOST empty to print OTP codes to the console (dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=StockSense <no-reply@stocksense.dev>
